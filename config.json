{
  "version": "1.4.0",
  "appName": "Тренажёр HTML, CSS & JS",

  "timeSource": {
    "providers": [
      {
        "name": "TimeAPI.io",
        "url": "https://timeapi.io/api/Time/current/zone?timeZone=Asia/Krasnoyarsk",
        "path": "dateTime",
        "parse": "date"
      },
      {
        "name": "WorldTimeAPI",
        "url": "https://worldtimeapi.org/api/timezone/Asia/Krasnoyarsk",
        "path": "unixtime",
        "multiplier": 1000
      },
      {
        "name": "GitHub Fallback",
        "url": "access/time.json",
        "path": "epochMs",
        "multiplier": 1
      }
    ],
    "resyncIntervalMs": 60000
  },

  "access": {
    "sitesFile":       "access/sites.json",
    "geopointsFile":   "access/geopoints.json",
    "schedulesFile":   "access/schedules.json",
    "testSetsFile":    "access/test-sets.json",
    "timeFile":        "access/time.json",
    "blockDurationMs": 7200000
  },

  "tests": {
    "indexFile": "tests/index.json"
  },

  "ui": {
    "showTimeSource": true,
    "blockOnTimeSyncFailure": false,
    "language": "ru"
  },

  "geolocation": {
    "timeoutMs": 10000,
    "maximumAge": 60000,
    "enableHighAccuracy": true,
    "cachePositionMs": 30000
  }
}